{
  "manifest_version": 3,
  "name": "Gemini Auto Prompt",
  "version": "1.0",
  "description": "Tự động prompt bài viết và tạo ảnh FB cho một YouTube video.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://gemini.google.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["content.js"]
    }
  ]
}
